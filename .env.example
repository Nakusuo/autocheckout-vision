# Desarrollo sin Docker: copia estos valores en tu terminal (export ...).
# Con Docker: cp .env.example .env y cambia la clave. Nunca subas claves reales.
GATEWAY_API_KEY=cambia-esto-por-una-clave-larga
GATEWAY_URL=https://localhost:8443
GATEWAY_PUBLIC_URL=https://localhost:8443

# Pago con Yape vía Mercado Pago (solo con docker-compose.mercadopago.yml o KIOSK_PAYMENT=yape).
# Credenciales de PRUEBA: mercadopago.com.pe/developers/panel → tu aplicación → Credenciales.
# KIOSK_PAYMENT=yape
# MP_PUBLIC_KEY=TEST-xxxxxxxx
# MP_ACCESS_TOKEN=TEST-xxxxxxxx

# Quiosco público (docker-compose.publico.yml, ver docs/NUBE.md): ≥ 16 caracteres cada una
# (genéralas con: openssl rand -hex 16)
KIOSK_CAJA_KEY=
KIOSK_NOTIFIER_KEY=
# Nombre de la bodega en la boleta (opcional). Sin él, la boleta dice «Caserito».
KIOSK_TIENDA=

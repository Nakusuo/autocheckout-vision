{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "mutate": [
    "src/kiosk/screens/Escaneo.tsx",
    "src/kiosk/screens/Lines.tsx",
    "src/kiosk/screens/Confirmar.tsx",
    "src/kiosk/screens/Pago.tsx",
    "src/format.ts"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": null
  },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "commandRunner": {
    "command": "npx vitest run src/kiosk src/format.test.ts"
  }
}

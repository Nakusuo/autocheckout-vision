# Igual que el proxy de Vite (vite.config.ts): /api, /sim/ y /ws van a kiosk-api.
# El navegador ve un solo origen (http://localhost:5173), que es el único que acepta la API.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    # Redirecciones relativas: detrás del puerto publicado (5173) no debe aparecer el 8080.
    absolute_redirect off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location /api/ {
        proxy_pass http://${KIOSK_API};
        proxy_set_header Host $host;
    }

    # /sim (sin barra) es la página del simulador; /sim/... son rutas de la API simulada.
    # Sin esta regla exacta, nginx redirigiría /sim a /sim/ por el proxy de abajo.
    location = /sim {
        try_files /index.html =404;
    }

    location /sim/ {
        proxy_pass http://${KIOSK_API};
        proxy_set_header Host $host;
    }

    location /ws {
        proxy_pass http://${KIOSK_API};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    # Rutas de la aplicación (/, /sim, /caja): siempre index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

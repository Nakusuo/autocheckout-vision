# Igual que el proxy de Vite (vite.config.ts): /api, /sim/ y /ws van a kiosk-api.
# El navegador ve un solo origen (http://localhost:5173), que es el único que acepta la API.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    # Redirecciones relativas: detrás del puerto publicado (5173) no debe aparecer el 8080.
    absolute_redirect off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # /sim muestra la vista del cliente en un iframe del mismo origen: DENY lo dejaría en blanco.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    location /api/ {
        # Recuadro de la cámara del navegador (~30 KB); la API rechaza más de 2 MB
        client_max_body_size 2m;
        proxy_pass http://${KIOSK_API};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # /sim (sin barra) es la página del simulador; /sim/... son rutas de la API simulada.
    # Sin esta regla exacta, nginx redirigiría /sim a /sim/ por el proxy de abajo.
    location = /sim {
        try_files /index.html =404;
    }

    location /sim/ {
        proxy_pass http://${KIOSK_API};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /ws {
        proxy_pass http://${KIOSK_API};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    # Rutas de la aplicación (/, /sim, /caja): siempre index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
